{
  "expo": {
    "name": "DuaVakti",
    "slug": "duavakti",
    "owner": "okayduman299",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080A0D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.shaesdoes.duavakti",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A0D"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.shaesdoes.duavakti",
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DuaVakti, namaz vakitlerini bulunduğun konuma göre göstermek için konumunu kullanır."
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/withDuaVaktiWidgets"
    ],
    "extra": {
      "eas": {
        "projectId": "b6ba130a-5c98-4a7b-b815-1a87526bf083"
      }
    }
  }
}
