{
  "name": "duavakti-rebuild",
  "version": "1.7.7",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "typecheck:offline": "tsc -p tsconfig.offline.json",
    "test:logic": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "verify": "node scripts/verify.mjs",
    "test": "npm run test:logic && npm run verify",
    "test:all": "npm run typecheck && npm test",
    "test:offline": "npm run typecheck:offline && npm run test:logic && npm run verify",
    "export:android": "expo export --platform android",
    "prebuild:android": "expo prebuild --platform android --clean",
    "verify:prebuild": "node scripts/verify-prebuild.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "^57.0.2",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.0",
    "expo-location": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-speech": "~57.0.2",
    "expo-task-manager": "~57.0.15",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.8.3"
  }
}
