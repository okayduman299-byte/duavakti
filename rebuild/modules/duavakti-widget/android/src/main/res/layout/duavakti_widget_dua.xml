<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center_vertical"
  android:background="@drawable/widget_background"
  android:padding="18dp">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="GÜNÜN DUASI"
    android:textColor="#8EC2A1"
    android:textSize="10sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/dua_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="İlim duası"
    android:textColor="#F2F0EA"
    android:textSize="19sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/dua_meaning"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="10dp"
    android:ellipsize="end"
    android:maxLines="5"
    android:text="Rabbim! İlmimi artır."
    android:textColor="#D8D8D2"
    android:textSize="14sp" />

  <TextView
    android:id="@+id/dua_source"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Tâhâ 20:114"
    android:textColor="#8EC2A1"
    android:textSize="10sp"
    android:textStyle="bold" />
</LinearLayout>
